{%- comment -%}
  FAQ with categories: a menu on the left and the questions of the chosen category on the right.
  Each category is a _faq-category block. assets/faq-categories.js shows one category at a time and reads the
  URL hash (#returns); without JavaScript every category is shown one under the other.
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  assign nav_class = s.nav_preset
  assign nav_style = ''
  if s.nav_preset == 'custom'
    assign nav_class = 'custom-typography'
    if s.nav_font_size != blank
      assign nav_class = nav_class | append: ' custom-font-size'
    endif
    capture nav_style
      render 'custom-typography-style', settings: s, prefix: 'nav_'
    endcapture
  endif
-%}

<script
  src="{{ 'faq-categories.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% if s.background_color != blank %}
  {% render 'contrast-override', background_color: s.background_color, section_id: section.id %}
{% endif %}

<div class="section-background{% if s.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>

<faq-categories
  class="faq section section--{{ s.section_width }}{% if s.background_color != blank %} color-custom-{{ section.id }}{% endif %}{% if s.sticky_nav %} faq--sticky{% endif %}{% if s.question_size > 0 %} faq--question-size{% endif %} spacing-style"
  style="
    {% render 'spacing-style', settings: s %}
    --faq-nav-width: {{ s.nav_width }}px;
    --faq-column-gap: {{ s.column_gap }}px;
    --faq-title-gap: {{ s.title_gap }}px;
    --faq-question-size: {{ s.question_size }}px;
    {% if s.nav_color != blank %}--faq-nav-color: {{ s.nav_color }};{% endif %}
    {% if s.active_background != blank %}--faq-active-background: {{ s.active_background }};{% endif %}
    {% if s.active_bar != blank %}--faq-active-bar: {{ s.active_bar }};{% endif %}
    {% if s.footnote_color != blank %}--faq-footnote-color: {{ s.footnote_color }};{% endif %}
  "
>
  <div class="faq__layout">
    <nav class="faq__nav" aria-label="FAQ">
      {%- comment -%} The links are built from the category blocks by faq-categories.js: a section cannot read the settings of its theme blocks. {%- endcomment -%}
      <ul
        class="faq__nav-list"
        data-faq-list
        data-link-class="faq__nav-link {{ nav_class }}"
        data-link-style="{{ nav_style | strip_newlines | escape }}"
      ></ul>
    </nav>

    <div class="faq__panels">
      {% content_for 'blocks' %}

      {%- if s.footnote != blank -%}
        <div class="faq__footnote text_caption">{{ s.footnote }}</div>
      {%- endif -%}
    </div>
  </div>
</faq-categories>

{% stylesheet %}
  faq-categories {
    display: block;
    scroll-margin-block-start: var(--header-height, 0px);
  }

  .faq__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 24px;
    align-items: start;
  }

  .faq__nav-list {
    display: flex;
    gap: 8px;
    margin: 0;
    padding: 0 0 8px;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: rgb(var(--color-foreground-rgb) / var(--opacity-40)) transparent;
  }

  .faq__nav-list > li {
    flex: none;
  }

  .faq__nav-link {
    display: block;
    padding: 12px 18px;
    white-space: nowrap;
    color: var(--faq-nav-color, inherit);
    text-decoration: none;
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
  }

  .faq__nav-link[aria-current='true'] {
    background: var(--faq-active-background, rgb(var(--color-foreground-rgb) / var(--opacity-5)));
    border-color: var(--faq-active-bar, var(--color-foreground));
  }

  .faq--question-size .accordion {
    --summary-font-size: var(--faq-question-size) !important;
  }

  .faq__footnote {
    margin-block-start: 28px;
    color: var(--faq-footnote-color, inherit);
    opacity: 0.7;
  }

  .faq__footnote p {
    margin: 0;
  }

  .faq__footnote a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* With scripting on, only the first category shows until faq-categories.js has picked the right one (no flash of all of them). */
  @media (scripting: enabled) {
    faq-categories:not([data-faq-ready]) .faq-panel:not(:first-child) {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    .faq__layout {
      grid-template-columns: var(--faq-nav-width, 300px) minmax(0, 1fr);
      column-gap: var(--faq-column-gap, 72px);
    }

    .faq--sticky .faq__nav {
      position: sticky;
      top: calc(var(--header-height, 0px) + 24px);
    }

    .faq__nav-list {
      flex-direction: column;
      gap: 4px;
      overflow: visible;
      padding: 0;
    }

    .faq__nav-link {
      white-space: normal;
      padding: 14px 20px;
      border-width: 0;
      border-inline-start: 2px solid transparent;
    }

    .faq__nav-link[aria-current='true'] {
      border-color: transparent;
      border-inline-start-color: var(--faq-active-bar, var(--color-foreground));
    }
  }
{% endstylesheet %}

