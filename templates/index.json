                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "text_24": {
              "type": "text",
              "settings": {
                "text": "<p>Every stone, whether forged over millennia or grown with modern precision, is carefully selected for its brilliance, character, and craftsmanship. By offering both, we provide the flexibility to build a personal collection that aligns with your specific investment goals and design preferences.</p>",
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
