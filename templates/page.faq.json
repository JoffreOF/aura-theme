              "blocks": {
                "accordion_row_01": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Does 18k gold tarnish or turn black?",
                    "open_by_default": true,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_04": {
                      "type": "text",
                      "settings": {
                        "text": "<p>No. Gold doesn’t rust, ever. Your piece is 75% pure gold, and the rest is a silver and copper blend that makes it strong enough for real life. Daily wear might dull the shine a little, but a quick clean brings it right back.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
