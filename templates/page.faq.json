                  "settings": {
                    "heading": "How should I store it?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_06": {
                      "type": "text",
                      "settings": {
                        "text": "<p>On its own, in your Aura box or a soft pouch. 18k gold is on the softer side, so it can pick up scratches from rubbing against other pieces.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
                        "font_size": "0.9375rem",
                        "font_size_mobile": "0.875rem",
                        "weight": "",
