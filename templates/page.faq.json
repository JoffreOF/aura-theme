                  },
                  "blocks": {
                    "text_24": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Measure the inside diameter of a ring that fits you, or the circumference of your finger, and match it on our size guide. We offer US sizes 4 to 10, in half sizes.</p>",
                        "width": "100%",
