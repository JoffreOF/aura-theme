                  "block_order": [
                    "text_31"
                  ]
                },
                "accordion_row_29": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Can I pay in installments?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_32": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Yes. Peruvian cards can pay in up to 6 interest-free installments through Mercado Pago.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
                        "font_size": "0.9375rem",
                        "font_size_mobile": "",
                        "weight": "",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "text_color": "{{ settings.color_palette.color1 }}",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_32"
                  ]
                },
                "accordion_row_30": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Why do prices change?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_33": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Our prices are tied to the gold price, updated every day at 10:00 AM (Lima time), so they move with the market. It’s the same transparency that lets you know exactly what you’re paying for.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
                        "font_size": "0.9375rem",
                        "font_size_mobile": "",
                        "weight": "",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "text_color": "{{ settings.color_palette.color1 }}",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_33"
                  ]
                },
                "accordion_row_31": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Is my price locked in when I check out?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_34": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Yes. The price you see at checkout is the price you pay, regardless of later movements in the gold price.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
                        "font_size": "0.9375rem",
                        "font_size_mobile": "",
                        "weight": "",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "text_color": "{{ settings.color_palette.color1 }}",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_34"
                  ]
                },
                "accordion_row_32": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "In which currency are prices shown?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_35": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Prices are shown and charged in US dollars. If you pay with a foreign card, your bank may apply its own exchange rate or fees.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
                        "font_size": "0.9375rem",
                        "font_size_mobile": "",
                        "weight": "",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "text_color": "{{ settings.color_palette.color1 }}",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_35"
                  ]
                },
                "accordion_row_33": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Are my payments secure?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_36": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Yes. All payments are processed through Mercado Pago, with bank-level encryption. Aura never sees or stores your card details.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
                        "font_size": "0.9375rem",
                        "font_size_mobile": "",
                        "weight": "",
                        "line_height": "loose",
                        "letter_spacing": "normal",
