                "padding-inline-end": 0
              },
              "blocks": {
                "accordion_row_14": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Can I return my piece?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_17": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Returns are accepted within 30 calendar days of delivery, exclusively when the item you received is incorrect or damaged. Returns for any other reason, including changes of mind, will not be accepted.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
                        "font_size": "0.9375rem",
                        "font_size_mobile": "",
                        "weight": "",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "text_color": "{{ settings.color_palette.color1 }}",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_17"
                  ]
                },
                "accordion_row_15": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Can I return it if I just changed my mind?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_18": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Unfortunately not. Every Aura piece is made with care and real gold, so we only accept returns for defects or order errors.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
                        "font_size": "0.9375rem",
                        "font_size_mobile": "",
                        "weight": "",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "text_color": "{{ settings.color_palette.color1 }}",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_18"
                  ]
                },
                "accordion_row_16": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "How do I request a return?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_19": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Email us at <a href=\"mailto:helloauracapital@gmail.com\">helloauracapital@gmail.com</a> with your order number, a short description of the issue, and a few photos of the piece. We’ll guide you from there.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
                        "font_size": "0.9375rem",
                        "font_size_mobile": "",
                        "weight": "",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "text_color": "{{ settings.color_palette.color1 }}",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_19"
                  ]
                },
                "accordion_row_17": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "What condition does the piece need to be in?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_20": {
                      "type": "text",
                      "settings": {
                        "text": "<p>The piece must be returned unworn, with no signs of use, in its original packaging and together with your proof of purchase. Returns missing any of these requirements will not be accepted.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
                        "font_size": "0.9375rem",
                        "font_size_mobile": "",
                        "weight": "",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "text_color": "{{ settings.color_palette.color1 }}",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_20"
                  ]
                },
                "accordion_row_18": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Can I return a bespoke or engraved piece?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_21": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Bespoke and engraved pieces are made exclusively for you and are final sale. The only exception is a verified manufacturing defect.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
                        "font_size": "0.9375rem",
                        "font_size_mobile": "",
                        "weight": "",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "text_color": "{{ settings.color_palette.color1 }}",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_21"
                  ]
                },
                "accordion_row_19": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "What isn’t covered?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_22": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Returns do not cover damage caused by everyday wear, including scratches, dents, bent shapes, or loose stones resulting from normal use or accidents. Any piece that has been resized, altered, or repaired by a jeweler other than Aura is also excluded.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
                        "font_size": "0.9375rem",
                        "font_size_mobile": "",
                        "weight": "",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "text_color": "{{ settings.color_palette.color1 }}",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_22"
                  ]
                },
                "accordion_row_20": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Who pays for return shipping?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_23": {
                      "type": "text",
                      "settings": {
                        "text": "<p>If your return qualifies and the issue is a defect or a mistake on our end, we will cover return shipping. Otherwise, return shipping and international handling costs are on you and aren’t refundable.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
                        "font_size": "0.9375rem",
                        "font_size_mobile": "",
                        "weight": "",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "text_color": "{{ settings.color_palette.color1 }}",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_23"
                  ]
                }
              },
              "block_order": [
                "accordion_row_14",
                "accordion_row_15",
                "accordion_row_16",
                "accordion_row_17",
                "accordion_row_18",
                "accordion_row_19",
                "accordion_row_20"
              ]
            }
