        "faq_category_04": {
          "type": "_faq-category",
          "name": "Returns & exchanges",
          "settings": {
            "title": "Returns & exchanges",
            "anchor": "returns-exchanges"
          },
          "blocks": {
            "accordion_04": {
              "type": "accordion",
              "settings": {
                "icon": "plus",
                "dividers": true,
                "divider_color": "{{ settings.color_palette.color7 }}",
                "type_preset": "paragraph",
                "background_color": "",
