                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_10": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Free across Lima Metropolitana and Callao. Shipping to the rest of Peru is a flat rate with Olva, and international shipping is calculated at checkout with DHL Express rates.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
