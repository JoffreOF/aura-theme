        "faq_category_06": {
          "type": "_faq-category",
          "name": "Gold quality",
          "settings": {
            "title": "Gold quality",
            "anchor": "gold-quality"
          },
          "blocks": {
            "accordion_06": {
              "type": "accordion",
              "settings": {
                "icon": "plus",
                "dividers": true,
                "divider_color": "{{ settings.color_palette.color7 }}",
                "type_preset": "paragraph",
                "background_color": "",
                "text_color": "",
                "border": "none",
                "border_width": 1,
                "border_opacity": 100,
                "border_color": "",
                "border_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {
                "accordion_row_23": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "What does 18k mean?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_26": {
                      "type": "text",
                      "settings": {
                        "text": "<p>It means your piece is 75% pure gold. The remaining 25% is a blend of silver and copper that makes it strong enough for everyday wear.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
                        "font_size": "0.9375rem",
                        "font_size_mobile": "",
                        "weight": "",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "text_color": "{{ settings.color_palette.color1 }}",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_26"
                  ]
                },
                "accordion_row_24": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Why 18k and not 24k?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_27": {
                      "type": "text",
                      "settings": {
                        "text": "<p>24k gold is 99.9% pure, but it’s so soft it dents and wears down quickly. 18k is the perfect balance: enough gold to hold real value, and enough strength to be worn every day forever.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
                        "font_size": "0.9375rem",
                        "font_size_mobile": "",
                        "weight": "",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "text_color": "{{ settings.color_palette.color1 }}",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_27"
                  ]
                },
                "accordion_row_25": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "How can I verify my piece is real 18k gold?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_28": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Every Aura piece is stamped with “18k”, the international mark for 75% gold, and comes with a certificate of authenticity.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
                        "font_size": "0.9375rem",
                        "font_size_mobile": "",
                        "weight": "",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "text_color": "{{ settings.color_palette.color1 }}",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_28"
                  ]
                },
                "accordion_row_26": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Where does your gold come from?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_29": {
                      "type": "text",
                      "settings": {
                        "text": "<p>We work exclusively with responsibly sourced gold from traceable Peruvian suppliers, committed to environmental stewardship. Each piece is then handcrafted by our local artisans under fair conditions.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
                        "font_size": "0.9375rem",
                        "font_size_mobile": "",
                        "weight": "",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "text_color": "{{ settings.color_palette.color1 }}",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_29"
                  ]
                },
                "accordion_row_27": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Is 18k gold suitable for sensitive skin?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_30": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Our 18k gold is alloyed with silver and copper, without nickel, which is the most common cause of skin reactions. Most people with sensitive skin wear it comfortably.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
                        "font_size": "0.9375rem",
                        "font_size_mobile": "",
                        "weight": "",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "text_color": "{{ settings.color_palette.color1 }}",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_30"
                  ]
                }
              },
              "block_order": [
                "accordion_row_23",
                "accordion_row_24",
                "accordion_row_25",
                "accordion_row_26",
                "accordion_row_27"
              ]
            }
          },
          "block_order": [
