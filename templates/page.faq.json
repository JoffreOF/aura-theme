                  "blocks": {
                    "text_31": {
                      "type": "text",
                      "settings": {
                        "text": "<p>We process all payments securely through Mercado Pago, which accepts major credit and debit cards, as well as other local payment options available in Peru.</p>",
                        "width": "100%",
