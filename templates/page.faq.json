                  "block_order": [
                    "text_04"
                  ]
                },
                "accordion_row_02": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Can I wear it every day?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_05": {
                      "type": "text",
                      "settings": {
                        "text": "<p>That’s the whole point. Just take it off for the gym, heavy lifting, or cleaning day. Solid gold is tough, but it’s not invincible.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
                        "font_size": "0.9375rem",
                        "font_size_mobile": "0.875rem",
                        "weight": "",
                        "line_height": "loose",
