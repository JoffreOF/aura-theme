                  "type": "_accordion-row",
                  "settings": {
                    "heading": "How long does a bespoke piece take?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_09": {
                      "type": "text",
                      "settings": {
                        "text": "<p>About 30 business days. That time covers everything that makes your piece one of a kind: a personal design consultation, sourcing your gemstones, a custom CAD render, and crafting the final piece.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
