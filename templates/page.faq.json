        "faq_category_08": {
          "type": "_faq-category",
          "name": "My portfolio",
          "settings": {
            "title": "My portfolio",
            "anchor": "my-portfolio"
          },
          "blocks": {
            "accordion_08": {
              "type": "accordion",
              "settings": {
                "icon": "plus",
                "dividers": true,
                "divider_color": "{{ settings.color_palette.color7 }}",
                "type_preset": "paragraph",
                "background_color": "",
                "text_color": "",
                "border": "none",
                "border_width": 1,
                "border_opacity": 100,
                "border_color": "",
                "border_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {
                "accordion_row_34": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "What is my Aura Portfolio?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_37": {
                      "type": "text",
                      "settings": {
                        "text": "<p>It’s your personal space to see what your jewelry is worth. Every piece you buy is recorded with its gold content, and its value updates daily with the gold price, just like tracking an investment.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
                        "font_size": "0.9375rem",
                        "font_size_mobile": "",
                        "weight": "",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "text_color": "{{ settings.color_palette.color1 }}",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_37"
                  ]
                },
                "accordion_row_35": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Is this a financial product?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_38": {
                      "type": "text",
                      "settings": {
                        "text": "<p>No. You own physical jewelry, not shares or a fund. The portfolio is a tool to help you understand the value of what you own.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
                        "font_size": "0.9375rem",
                        "font_size_mobile": "",
                        "weight": "",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "text_color": "{{ settings.color_palette.color1 }}",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_38"
                  ]
                },
                "accordion_row_36": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "What is the cost basis of my piece?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_39": {
                      "type": "text",
                      "settings": {
                        "text": "<p>It’s the gold value of your piece on the day you bought it: its gold weight, times its 75% purity, times that day’s gold spot price. It’s your starting point.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
                        "font_size": "0.9375rem",
                        "font_size_mobile": "",
                        "weight": "",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "text_color": "{{ settings.color_palette.color1 }}",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_39"
                  ]
                },
                "accordion_row_37": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Why is my portfolio value lower than what I paid?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_40": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Your price includes a disclosed craftsmanship markup that pays for ethically sourced gold and our artisans’ fair wages. Your portfolio tracks only the gold, so it starts below your purchase price and moves with the market from there.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
                        "font_size": "0.9375rem",
                        "font_size_mobile": "",
                        "weight": "",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "text_color": "{{ settings.color_palette.color1 }}",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_40"
                  ]
                },
                "accordion_row_38": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "How often is the value updated?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_41": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Every day at 10:00 AM (Lima time), using the gold spot price.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
                        "font_size": "0.9375rem",
                        "font_size_mobile": "",
                        "weight": "",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "text_color": "{{ settings.color_palette.color1 }}",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_41"
                  ]
                },
                "accordion_row_39": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Can my portfolio lose value?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_42": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Yes. Gold prices go up and down. Historically gold has protected value over the long term, but past performance doesn’t guarantee future results.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
                        "font_size": "0.9375rem",
                        "font_size_mobile": "",
                        "weight": "",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "text_color": "{{ settings.color_palette.color1 }}",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_42"
                  ]
                },
                "accordion_row_40": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Are gemstones included in the value?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_43": {
                      "type": "text",
                      "settings": {
                        "text": "<p>No. Your portfolio values only the gold content. Gemstones add beauty and character, but aren’t part of the gold valuation.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
                        "font_size": "0.9375rem",
                        "font_size_mobile": "",
                        "weight": "",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "text_color": "{{ settings.color_palette.color1 }}",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_43"
                  ]
                },
                "accordion_row_41": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Can I sell my piece back to Aura?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_44": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Yes, you can request a buyback anytime by writing to <a href=\"mailto:helloauracapital@gmail.com\">helloauracapital@gmail.com</a>. Each request is reviewed individually, and eligible offers are based on the piece’s gold content at that day’s spot price, subject to our buyback terms.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
                        "font_size": "0.9375rem",
                        "font_size_mobile": "",
                        "weight": "",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "text_color": "{{ settings.color_palette.color1 }}",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_44"
                  ]
                },
                "accordion_row_42": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "How do I access my portfolio?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_45": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Create an account with the email you used at checkout. Your pieces will appear automatically.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-body--family)",
                        "font_size": "0.9375rem",
