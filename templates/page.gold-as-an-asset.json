                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {
                "intro": {
                  "type": "text",
                  "settings": {
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "custom",
                    "font": "var(--font-body--family)",
                    "font_size": "1.0625rem",
                    "font_size_mobile": "1rem",
                    "weight": "400",
                    "line_height": "loose",
                    "letter_spacing": "normal",
                    "case": "none",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0,
                    "text": "<p>Gold has held its value for thousands of years, through wars, crises and changing currencies. Here are five simple reasons why it's an asset in its own right.</p>",
                    "text_color": "{{ settings.color_palette.color1 }}"
                  },
                  "blocks": {}
                }
              },
              "block_order": [
