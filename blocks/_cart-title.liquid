

{% doc %}
  Cart Title

  Renders the cart title or empty cart state.

  @param {boolean} [force_empty] - Force render empty cart state

  @example
  {% render 'cart-title', force_empty: true %}
{% enddoc %}

{% liquid
  assign block_settings = block.settings
  if block_settings.text_color != blank
    render 'contrast-override', background_color: '', text_color: block_settings.text_color, section_id: block.id
  endif
%}

<div
  class="cart-title spacing-style text-{{ block_settings.alignment }}{% if block_settings.text_color != blank %} color-custom-{{ block.id }}{% endif %}"
  style="{% render 'spacing-style', settings: block_settings %}"
  {{ block.shopify_attributes }}
>
  {%- liquid
    assign title_class = block_settings.type_preset | default: 'h2'
    assign title_style = ''
    if block_settings.type_preset == 'custom'
      assign title_class = 'custom-typography'
      if block_settings.font_size != blank
        assign title_class = title_class | append: ' custom-font-size'
      endif
      capture title_style
        render 'typography-style', settings: block_settings
      endcapture
    endif
  -%}
  <h1 class="{{ title_class }}"{% if title_style != blank %} style="{{ title_style }}"{% endif %}>
    {%- if cart.empty? or force_empty -%}
      {{ 'content.your_cart_is_empty' | t }}
    {%- else -%}
      {{ block_settings.title }}
      {%- if block_settings.show_count -%}{% render 'cart-bubble' %}{%- endif -%}
    {%- endif -%}
  </h1>
  {%- if block_settings.show_subtitle and cart.empty? == false and force_empty != true -%}
    {%- assign pieces_text = 'cart_aura.pieces' | t: count: cart.item_count -%}
    <p class="cart-title__subtitle">{{ 'cart_aura.subtitle' | t: pieces: pieces_text }}</p>
  {%- endif -%}
</div>

{% stylesheet %}
  .cart-title__subtitle {
    margin: var(--gap-xs) 0 0;
    font-size: var(--font-size--sm);
    opacity: 0.75;
  }

  .cart-title h1 {
    margin-block-end: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--gap-sm);
  }

  .cart-title .cart-bubble {
    width: fit-content;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: auto;
    padding: var(--cart-padding);
  }

  .cart-title .cart-bubble[data-maintain-ratio] {
    width: min(1lh, 26px);
    height: min(1lh, 26px);
  }

  .cart-title .cart-bubble .cart-bubble__background {
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
  }

  .cart-title .cart-bubble__text {
    color: var(--color-foreground);
    font-family: var(--font-paragraph--family);
    font-weight: var(--font-paragraph--weight);
    font-size: clamp(var(--font-size--3xs), 0.75em, var(--font-size--xs));
  }
{% endstylesheet %}

