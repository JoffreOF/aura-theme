{%- doc -%}
  Gold as an asset: a row of numbered reasons. One panel is open at a time, the others fold into narrow vertical tabs. On desktop it can advance by itself (with a pause button); on mobile it is a stacked accordion. Children: Reason panel blocks. Script: assets/gold-asset.js (custom element gold-reasons).
{%- enddoc -%}

{% assign s = block.settings %}
<gold-reasons class="ga-reasons spacing-style" data-autoplay="{{ s.autoplay }}" data-duration="{{ s.duration | times: 1000 }}" style="{% render 'spacing-padding', settings: s %} --ga-height:{{ s.panel_height }}px;--ga-radius:{{ s.corner_radius }}px;--ga-duration:{{ s.duration }}s;{% if s.background_color != blank %}--ga-panel-bg:{{ s.background_color }};{% endif %}{% if s.text_color != blank %}--ga-panel-text:{{ s.text_color }};{% endif %}{% if s.active_background != blank %}--ga-active-bg:{{ s.active_background }};{% endif %}{% if s.active_text != blank %}--ga-active-text:{{ s.active_text }};{% endif %}{% if s.accent_color != blank %}--ga-accent:{{ s.accent_color }};{% endif %}{% if s.border_color != blank %}--ga-edge:{{ s.border_color }};{% endif %}{% render 'typography-vars', settings: s, prefix: 'title_', name: 'ga-title' %}{% render 'typography-vars', settings: s, prefix: 'body_', name: 'ga-body' %}" {{ block.shopify_attributes }}>
  <div class="ga-reasons__list">{% content_for 'blocks' %}</div>
  <button class="ga-reasons__motion" type="button" data-motion hidden data-pause="{{ s.pause_label | escape }}" data-resume="{{ s.resume_label | escape }}">{{ s.pause_label }}</button>
</gold-reasons>

{% stylesheet %}
gold-reasons{display:block;width:100%;min-width:0}
.ga-reasons__list{display:flex;flex-direction:column;gap:12px}
.ga-reason{min-width:0;border:1px solid var(--ga-edge,var(--color-foreground));border-radius:var(--ga-radius,0);background:var(--ga-panel-bg,transparent);color:var(--ga-panel-text,var(--color-foreground));overflow:hidden}
.ga-reason__button{appearance:none;width:100%;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:24px;border:0;border-radius:0;background:transparent;color:inherit;text-align:left;cursor:pointer;font-family:var(--font-body--family);font-size:12px;letter-spacing:.12em;text-transform:uppercase}
.ga-reason__number{font-family:var(--ga-title-font-family,var(--font-heading--family));font-size:24px;font-weight:400;line-height:1;color:var(--ga-accent,#c4a35a)}
.ga-reason__body{padding:0 24px 28px;display:flex;flex-direction:column;gap:20px;flex:1;min-height:0}
.ga-reason__body[hidden],.ga-reasons__motion[hidden]{display:none}
.ga-reason__heading{font-family:var(--ga-title-font-family,var(--font-body--family));font-size:var(--ga-title-font-size,1rem);font-weight:var(--ga-title-font-weight,400);line-height:var(--ga-title-line-height,1.6);letter-spacing:var(--ga-title-letter-spacing,normal);text-transform:var(--ga-title-text-transform,none);margin:0;color:inherit;text-wrap:balance}
.ga-reason__copy{font-family:var(--ga-body-font-family,var(--font-body--family));font-size:var(--ga-body-font-size,1rem);font-weight:var(--ga-body-font-weight,400);line-height:var(--ga-body-line-height,1.6);letter-spacing:var(--ga-body-letter-spacing,normal);text-transform:var(--ga-body-text-transform,none);margin:0;text-wrap:pretty}
.ga-reason__copy p{margin:0}
.ga-reasons[data-ready] .ga-reason[data-active]{background:var(--ga-active-bg,#3a1630);color:var(--ga-active-text,#fffaf8);border-color:var(--ga-active-bg,#3a1630)}
.ga-reasons[data-ready] .ga-reason[data-active] .ga-reason__number{font-size:64px;letter-spacing:0}
.ga-reasons[data-ready] .ga-reason:not([data-active]) .ga-reason__button{min-height:72px}
.ga-reason__progress{display:none;height:1px;background:rgb(255 255 255 / .2);margin-top:8px;overflow:hidden}
.ga-reason__progress i{display:block;height:100%;background:var(--ga-accent,#c4a35a);transform:scaleX(0);transform-origin:left}
.ga-reasons[data-automatic] .ga-reason[data-active] .ga-reason__progress{display:block}
.ga-reasons[data-automatic] .ga-reason[data-active] .ga-reason__progress i{animation:ga-panel-progress var(--ga-duration,9s) linear forwards;animation-play-state:paused}
.ga-reasons[data-running] .ga-reason[data-active] .ga-reason__progress i{animation-play-state:running}
.ga-reasons__motion{display:block;margin:16px 0 0 auto;padding:8px 0;border:0;background:transparent;color:var(--ga-panel-text,var(--color-foreground));font:inherit;font-size:12px;text-decoration:underline;text-underline-offset:4px;cursor:pointer}
.ga-reason__button:focus-visible,.ga-reasons__motion:focus-visible{outline:2px solid var(--ga-accent,#c4a35a);outline-offset:-4px}
@keyframes ga-panel-progress{to{transform:scaleX(1)}}
@media(min-width:750px){
 .ga-reasons[data-ready] .ga-reasons__list{flex-direction:row;height:var(--ga-height,540px)}
 .ga-reasons[data-ready] .ga-reason{flex:0 0 clamp(56px,6.3vw,92px);display:flex;flex-direction:column;transition:flex-grow .7s ease,background .5s ease}
 .ga-reasons[data-ready] .ga-reason[data-active]{flex:1 1 0}
 .ga-reasons[data-ready] .ga-reason:not([data-active]) .ga-reason__button{height:100%;flex-direction:column-reverse;padding:28px 12px}
 .ga-reasons[data-ready] .ga-reason:not([data-active]) .ga-reason__label{writing-mode:vertical-rl;transform:rotate(180deg);font-family:var(--ga-title-font-family,var(--font-heading--family));font-size:clamp(17px,1.8vw,26px);letter-spacing:0;text-transform:none;white-space:nowrap}
 .ga-reasons[data-ready] .ga-reason[data-active] .ga-reason__button{padding:36px 36px 24px;align-items:flex-start}
 .ga-reasons[data-ready] .ga-reason[data-active] .ga-reason__number{font-size:80px}
 .ga-reasons[data-ready] .ga-reason__body{padding:0 36px 36px;justify-content:flex-end}
}
@media(max-width:749px){.ga-reason__heading{font-size:var(--ga-title-font-size-mobile,var(--ga-title-font-size,2rem))}.ga-reason__copy{font-size:var(--ga-body-font-size-mobile,var(--ga-body-font-size,1rem))}}
@media(prefers-reduced-motion:reduce){.ga-reasons[data-ready] .ga-reason{transition:none}.ga-reason__progress{display:none!important}}
{% endstylesheet %}

