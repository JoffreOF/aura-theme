{%- doc -%}
  Gold as an asset: one capsule per piece type showing its layers, with a Day one / After a year of wear toggle. Can preview the wear once by itself. Children: Cross-section row blocks. Script: assets/gold-asset.js (custom element gold-cross-sections).
{%- enddoc -%}

{% assign s = block.settings %}
<gold-cross-sections class="ga-cross spacing-style" data-auto-wear="{{ s.auto_wear }}" data-delay="{{ s.wear_delay | times: 1000 }}" style="{% render 'spacing-padding', settings: s %}--ga-toggle-radius:{{ s.corner_radius }}px;--ga-capsule-height:{{ s.capsule_height }}px;{% if s.text_color != blank %}--ga-cross-text:{{ s.text_color }};{% endif %}{% if s.gold_color != blank %}--ga-cross-gold:{{ s.gold_color }};{% endif %}{% if s.worn_color != blank %}--ga-cross-worn:{{ s.worn_color }};{% endif %}{% if s.border_color != blank %}--ga-cross-edge:{{ s.border_color }};{% endif %}{% if s.active_background != blank %}--ga-toggle-bg:{{ s.active_background }};{% endif %}{% if s.active_text != blank %}--ga-toggle-text:{{ s.active_text }};{% endif %}{% render 'typography-vars', settings: s, prefix: 'title_', name: 'ga-cross-title' %}{% render 'typography-vars', settings: s, prefix: 'body_', name: 'ga-cross-body' %}" {{ block.shopify_attributes }}>
 <div class="ga-cross__bar"><span class="ga-cross__eyebrow">{{ s.label | escape }}</span><div class="ga-cross__toggle" data-wear-controls hidden role="group" aria-label="{{ s.toggle_label | escape }}"><button type="button" data-wear="false" aria-pressed="true">{{ s.day_label | escape }}</button><button type="button" data-wear="true" aria-pressed="false">{{ s.worn_label | escape }}</button></div></div>
 <div class="ga-cross__rows">{% content_for 'blocks' %}</div>
</gold-cross-sections>

{% stylesheet %}
gold-cross-sections{display:block;width:100%;color:var(--ga-cross-text,var(--color-foreground))}
.ga-cross__bar{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;margin-bottom:20px}
.ga-cross__eyebrow{font-family:var(--font-body--family);font-size:11px;letter-spacing:.16em;text-transform:uppercase}
.ga-cross__toggle{display:inline-flex;flex-wrap:wrap;padding:4px;border:1px solid var(--ga-cross-edge,rgb(243 234 229 / .3));border-radius:var(--ga-toggle-radius,0);gap:4px}
.ga-cross__toggle[hidden]{display:none}
.ga-cross__toggle button{font:inherit;font-size:13px;padding:10px 16px;border:0;border-radius:var(--ga-toggle-radius,0);background:transparent;color:inherit;cursor:pointer}
.ga-cross__toggle button[aria-pressed='true']{background:var(--ga-toggle-bg,#f3eae5);color:var(--ga-toggle-text,#3a1630)}
.ga-cross__toggle button:focus-visible{outline:2px solid var(--ga-cross-gold,#d9c29a);outline-offset:-3px}
.ga-cross__rows{border-top:1px solid var(--ga-cross-edge,rgb(243 234 229 / .2))}
.ga-cross-row{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.1fr) minmax(0,1.2fr) minmax(0,.6fr);gap:clamp(16px,2.6vw,40px);align-items:center;padding-block:30px;border-bottom:1px solid var(--ga-cross-edge,rgb(243 234 229 / .2))}
.ga-cross-row__title{font-family:var(--ga-cross-title-font-family,var(--font-body--family));font-size:var(--ga-cross-title-font-size,1rem);font-weight:var(--ga-cross-title-font-weight,400);line-height:var(--ga-cross-title-line-height,1.6);letter-spacing:var(--ga-cross-title-letter-spacing,normal);text-transform:var(--ga-cross-title-text-transform,none);margin:0;color:inherit;transition:opacity 1.2s}
.ga-cross-row__capsule{height:var(--ga-capsule-height,84px);position:relative;border-radius:999px;background:linear-gradient(180deg,#ebd6ac,var(--ga-cross-gold,#b8955a) 60%,#ae8d4e);overflow:hidden;transition:filter 1.6s,box-shadow 1.6s}
.ga-cross-row__core{position:absolute;inset:var(--ga-layer-day,6px);display:flex;align-items:center;justify-content:center;border-radius:999px;background:var(--ga-core,#8c8481);color:#f1ecea;font-family:var(--font-body--family);font-size:11px;font-weight:500;letter-spacing:.1em;text-transform:uppercase;transition:inset 1.6s ease}
.ga-cross-row[data-solid] .ga-cross-row__core{inset:0;background:transparent;color:var(--ga-toggle-text,#3a1630)}
.ga-cross-row__copy{font-family:var(--ga-cross-body-font-family,var(--font-body--family));font-size:var(--ga-cross-body-font-size,1rem);font-weight:var(--ga-cross-body-font-weight,400);line-height:var(--ga-cross-body-line-height,1.6);letter-spacing:var(--ga-cross-body-letter-spacing,normal);text-transform:var(--ga-cross-body-text-transform,none);transition:opacity 1.2s;text-wrap:pretty}
.ga-cross-row__copy p{margin:0}
.ga-cross-row__status{font-family:var(--font-body--family);font-size:11px;letter-spacing:.08em;text-transform:uppercase;text-align:right}
.ga-cross-row[data-solid] .ga-cross-row__title,.ga-cross-row[data-solid] .ga-cross-row__status{color:var(--ga-cross-gold,#d9c29a)}
.ga-cross[data-worn] .ga-cross-row:not([data-solid]) .ga-cross-row__core{inset:var(--ga-layer-worn,0px)}
.ga-cross[data-worn] .ga-cross-row:not([data-solid]) .ga-cross-row__title,.ga-cross[data-worn] .ga-cross-row:not([data-solid]) .ga-cross-row__copy{opacity:.45}
.ga-cross[data-worn] .ga-cross-row:not([data-solid]) .ga-cross-row__status{color:var(--ga-cross-worn,#eba3a3)}
.ga-cross[data-worn] .ga-cross-row:not([data-solid]) .ga-cross-row__capsule{filter:saturate(.35) brightness(.85)}
.ga-cross[data-worn] .ga-cross-row[data-solid] .ga-cross-row__capsule{box-shadow:0 0 0 1px var(--ga-cross-gold,#d9c29a),0 0 40px -6px rgb(217 194 154 / .5)}
@media(max-width:749px){.ga-cross-row{grid-template-columns:minmax(0,1fr);gap:16px}.ga-cross-row__status{text-align:left}.ga-cross-row__title{font-size:var(--ga-cross-title-font-size-mobile,var(--ga-cross-title-font-size,1.75rem))}.ga-cross-row__copy{font-size:var(--ga-cross-body-font-size-mobile,var(--ga-cross-body-font-size,1rem))}}
@media(prefers-reduced-motion:reduce){.ga-cross-row__core,.ga-cross-row__capsule,.ga-cross-row__title,.ga-cross-row__copy{transition:none}}
{% endstylesheet %}

