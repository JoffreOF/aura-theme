{%- doc -%}
  "or 6 x $115.23 interest-free": the selected variant's price divided into equal payments.
  The amount is rounded to the cent. Needs a product in context (closest.product).
{%- enddoc -%}

{%- liquid
  assign variant = closest.product.selected_or_first_available_variant
  assign payments = block.settings.payments | plus: 0
  assign alignment = block.settings.alignment | replace: 'left', 'flex-start' | replace: 'right', 'flex-end'

  assign show = false
  if variant != blank and variant.price > 0 and payments >= 2
    assign show = true
    assign per_payment = variant.price | times: 1.0 | divided_by: payments | round
    assign amount = per_payment | money
  endif
-%}

{%- if show -%}
  <div
    class="product-installments spacing-style {{ block.settings.type_preset }}"
    style="
      {% render 'spacing-padding', settings: block.settings %}
      --installments-align: {{ alignment }};
      {% if block.settings.text_color != blank %}--color: {{ block.settings.text_color }};{% endif %}
    "
    {{ block.shopify_attributes }}
  >
    {%- if block.settings.show_icon -%}
      <span class="product-installments__icon" aria-hidden="true">
        <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
          <rect x="2.5" y="4.5" width="15" height="11" rx="1.5" stroke="currentColor" stroke-width="1.2"/>
          <path d="M2.5 8h15" stroke="currentColor" stroke-width="1.2"/>
        </svg>
      </span>
    {%- endif -%}
    <span>{{ 'blocks.installments.label' | t: count: payments, amount: amount }}</span>
  </div>
{%- elsif request.design_mode -%}
  <div class="product-installments product-installments--hint" {{ block.shopify_attributes }}>Installments: needs a product with a price</div>
{%- endif -%}

{% stylesheet %}
  .product-installments {
    display: flex;
    align-items: center;
    justify-content: var(--installments-align, flex-start);
    gap: var(--gap-xs);
    color: var(--color, var(--color-foreground));
  }

  .product-installments__icon {
    display: inline-flex;
    flex: none;
    width: 1.1em;
    height: 1.1em;
  }

  .product-installments__icon svg {
    width: 100%;
    height: 100%;
  }

  .product-installments--hint {
    opacity: 0.5;
    font-size: 0.75rem;
  }
{% endstylesheet %}

