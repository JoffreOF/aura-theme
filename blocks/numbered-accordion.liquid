{%- doc -%}
  Accordion with a number, a title and a plus / minus on every row ("01  Inflation protection  +").
  Rows are blocks (see _numbered-accordion-row). Number and title styles are set here and read by the rows
  through CSS variables, like the theme's own accordion does.
{%- enddoc -%}

{%- liquid
  assign s = block.settings
  assign number_column = s.number_column
  assign number_column_mobile = s.number_column_mobile
  if s.show_numbers == false
    assign number_column = 0
    assign number_column_mobile = 0
  endif
-%}

<numbered-accordion
  class="numbered-accordion spacing-style{% if s.dividers %} numbered-accordion--dividers{% endif %}{% if s.show_numbers == false %} numbered-accordion--no-numbers{% endif %}"
  {% if s.one_open %}data-one-open{% endif %}
  style="
    {% render 'spacing-padding', settings: s %}
    --acc-number-column: {{ number_column }}px;
    --acc-number-column-mobile: {{ number_column_mobile }}px;
    --acc-title-size-mobile: {{ s.title_size_mobile }}px;
    --acc-row-padding: {{ s.row_padding }}px;
    --acc-icon-size: {{ s.icon_size }}px;
    {% if s.divider_color != blank %}--acc-divider-color: {{ s.divider_color }};{% endif %}
    {% if s.icon_color != blank %}--acc-icon-color: {{ s.icon_color }};{% endif %}
    {% if s.number_color != blank %}--acc-number-color: {{ s.number_color }};{% endif %}
    {% if s.title_color != blank %}--acc-title-color: {{ s.title_color }};{% endif %}
    {% render 'typography-vars', settings: s, prefix: 'number_', name: 'acc-number' %}
    {% render 'typography-vars', settings: s, prefix: 'title_', name: 'acc-title' %}
  "
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</numbered-accordion>

{% stylesheet %}
  numbered-accordion {
    display: block;
    width: 100%;
  }

  .numbered-accordion__row {
    display: block;
    /* Rows that sit next to each other share one counter (01, 02, 03). */
    counter-increment: aura-acc;
  }

  .numbered-accordion--dividers .numbered-accordion__row {
    border-block-start: 1px solid var(--acc-divider-color, var(--color-border));
  }

  .numbered-accordion--dividers .numbered-accordion__row:last-child {
    border-block-end: 1px solid var(--acc-divider-color, var(--color-border));
  }
{% endstylesheet %}

