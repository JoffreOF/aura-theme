{%- doc -%}
  Breadcrumb line: "Home / Jewelry" above a collection title, "Home / Rings" above a product title.
  Uses the text block's own snippet, so it shares the text block's settings and click-to-edit.
  Needs a collection (closest.collection) or a product (closest.product) in context.
{%- enddoc -%}

{%- liquid
  assign home_label = block.settings.home_label | default: 'Home' | escape
  assign separator = block.settings.separator | default: '/' | escape

  assign product = closest.product
  assign current_collection = closest.collection
  assign parent_title = ''
  assign parent_url = ''

  if product != blank
    if product.type != blank
      assign parent_title = product.type
      assign type_handle = product.type | handle
      assign type_collection = collections[type_handle]
      assign parent_url = type_collection.url
    endif
  elsif current_collection != blank
    assign parent = block.settings.parent_collection
    if parent != blank and parent.id != current_collection.id
      assign parent_title = parent.title
      assign parent_url = parent.url
    endif
  elsif request.design_mode
    assign parent_title = 'Jewelry'
  endif
-%}

{%- capture breadcrumb -%}
  <nav
    class="breadcrumbs{% unless block.settings.underline_links %} breadcrumbs--plain{% endunless %}"
    aria-label="Breadcrumb"
  >
    <a href="{{ routes.root_url }}">{{ home_label }}</a>
    {%- if parent_title != blank -%}
      <span class="breadcrumbs__separator" aria-hidden="true">{{ separator }}</span>
      {%- if parent_url != blank -%}
        <a href="{{ parent_url }}">{{ parent_title | escape }}</a>
      {%- else -%}
        <span>{{ parent_title | escape }}</span>
      {%- endif -%}
    {%- endif -%}
  </nav>
{%- endcapture -%}

{% render 'text', block: block, fallback_text: breadcrumb %}

{% stylesheet %}
  .breadcrumbs a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .breadcrumbs--plain a {
    text-decoration: none;
  }

  .breadcrumbs__separator {
    margin-inline: 0.4em;
  }
{% endstylesheet %}

