{%- doc -%}
  One sample piece of the "virtual portfolio" table (blocks/portfolio-sample-table.liquid). Numbers are worked out from the shop's data:
    gold value then  = round(weight x 18k gram price on the purchase date, 2)   (last entry of gold.price_history on or before that date)
    you paid         = round(weight x 18k gram price on that date x markup, 2)   (markup with stones when the box is ticked)
    gold value today = round(weight x gold.price_18k_per_g, 2)
    fine gold        = 75% of the weight
  The row prints its numbers as data attributes; the table block adds them up. A sample, not a real customer's portfolio.
{%- enddoc -%}

{%- liquid
  assign s = block.settings
  assign history = shop.metafields.gold.price_history.value
  assign gram_now = shop.metafields.gold.price_18k_per_g.value | times: 1.0
  assign weight = s.weight | times: 1.0

  assign markup = shop.metafields.gold.markup.value | times: 1.0
  if s.with_stones
    assign markup = shop.metafields.gold.markup_stones.value | times: 1.0
    if markup <= 0
      assign markup = s.markup_stones | times: 1.0
    endif
  endif

  # Price on the purchase date: the last history entry on or before it (the first entry if the date is earlier).
  assign first_entry = history | first
  assign gram_then = first_entry[1] | times: 1.0
  for entry in history
    if entry[0] <= s.bought_date
      assign gram_then = entry[1] | times: 1.0
    else
      break
    endif
  endfor

  assign show = false
  if gram_now > 0 and gram_then > 0 and weight > 0 and markup > 0
    assign show = true
    assign then_cents = weight | times: gram_then | times: 100 | round
    assign paid_cents = weight | times: gram_then | times: markup | times: 100 | round
    assign now_cents = weight | times: gram_now | times: 100 | round
    assign diff_cents = now_cents | minus: then_cents
    assign diff_abs = diff_cents
    assign sign = '+'
    assign direction = 'up'
    if diff_cents < 0
      assign diff_abs = diff_cents | times: -1
      assign sign = '−'
      assign direction = 'down'
    endif
    assign pct = diff_cents | times: 100.0 | divided_by: then_cents
    if pct < 0
      assign pct = pct | times: -1
    endif
    assign fine_gold = weight | times: 0.75 | round: 2
    assign link = s.link | default: '/pages/contact'

    # Date written from the text itself (YYYY-MM-DD): the date filter can shift a day with time zones.
    assign month_names = 'Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec' | split: ','
    assign date_parts = s.bought_date | split: '-'
    assign month_index = date_parts[1] | plus: 0 | minus: 1
    assign day_number = date_parts[2] | plus: 0
    assign year_short = date_parts[0] | slice: 2, 2
    assign bought_text = month_names[month_index] | append: ' ' | append: day_number | append: ', ' | append: year_short
  endif
-%}

{%- if show -%}
  <tr
    class="ps__row"
    data-weight="{{ weight }}"
    data-then="{{ then_cents | divided_by: 100.0 }}"
    data-now="{{ now_cents | divided_by: 100.0 }}"
    {{ block.shopify_attributes }}
  >
    <td class="ps__piece">
      <span class="ps__cell">
        <span class="ps__thumb">
          {%- if s.image != blank -%}
            {{ s.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: s.name }}
          {%- endif -%}
        </span>
        <span class="ps__name">{{ s.name }}</span>
      </span>
    </td>
    <td data-label="{{ 'blocks.portfolio_sample_table.bought' | t }}">{{ bought_text }}</td>
    <td data-label="{{ 'blocks.portfolio_sample_table.fine_gold_short' | t }}">{{ fine_gold }} g</td>
    <td data-label="{{ 'blocks.portfolio_sample_table.you_paid' | t }}">{{ paid_cents | money }}</td>
    <td data-label="{{ 'blocks.portfolio_sample_table.value_then' | t }}">{{ then_cents | money }}</td>
    <td data-label="{{ 'blocks.portfolio_sample_table.value_today' | t }}">{{ now_cents | money }}</td>
    <td data-label="{{ 'blocks.portfolio_sample_table.change' | t }}" class="ps__change ps__change--{{ direction }}">
      {{ sign }}{{ diff_abs | money }} <span class="ps__pct">{{ sign }}{{ pct | round: 2 }}%</span>
    </td>
    <td class="ps__action"><a class="ps__buyback" href="{{ link }}">{{ 'blocks.portfolio_sample_table.request_buyback' | t }}</a></td>
  </tr>
{%- elsif request.design_mode -%}
  <tr><td colspan="8">Row hidden: the shop needs gold.price_18k_per_g, gold.markup and gold.price_history, and a weight above 0.</td></tr>
{%- endif -%}

{% schema %}
{
  "name": "Sample piece",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "One piece of the sample portfolio. Gold value then, you paid and gold value today are worked out from the shop's price history and markup."
    },
    {
      "type": "text",
      "id": "name",
      "label": "Piece",
      "default": "Rolo chain · 45 cm"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo"
    },
    {
      "type": "range",
      "id": "weight",
      "label": "Weight",
      "min": 1,
      "max": 11,
      "step": 0.1,
      "unit": "g",
      "default": 5.1
    },
    {
      "type": "text",
      "id": "bought_date",
      "label": "Bought on",
      "info": "YYYY-MM-DD. The gold price of that day (or the closest earlier one in the history) is used.",
      "default": "2024-11-09"
    },
    {
      "type": "checkbox",
      "id": "with_stones",
      "label": "Has gemstones",
      "info": "Uses the markup with gemstones.",
      "default": false
    },
    {
      "type": "range",
      "id": "markup_stones",
      "label": "Markup with gemstones",
      "info": "Used until the shop has the gold.markup_stones metafield.",
      "min": 1,
      "max": 3,
      "step": 0.1,
      "default": 1.9,
      "visible_if": "{{ block.settings.with_stones }}"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Request buyback link",
      "info": "Empty goes to the contact page."
    }
  ]
}
{% endschema %}
