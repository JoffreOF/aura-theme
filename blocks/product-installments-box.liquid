{%- doc -%}
  Boxed installments for the product page: "6 interest-free payments of $133.33" and a note line
  ("All cards via Mercado Pago"). The amount is the selected variant's price divided by the number of
  payments, rounded to the cent. Refreshes when a size is picked (see assets/variant-live.js).
{%- enddoc -%}

{%- liquid
  assign product = closest.product
  assign variant = product.selected_or_first_available_variant
  assign payments = block.settings.payments | plus: 0

  assign show = false
  if variant != blank and variant.price > 0 and payments >= 2
    assign show = true
    assign per_payment = variant.price | times: 1.0 | divided_by: payments | round
    assign amount = per_payment | money
  endif

  assign main_class = block.settings.main_preset
  assign main_style = ''
  if block.settings.main_preset == 'custom'
    assign main_class = 'custom-typography'
    if block.settings.main_font_size != blank
      assign main_class = main_class | append: ' custom-font-size'
    endif
    capture main_style
      render 'custom-typography-style', settings: block.settings, prefix: 'main_'
    endcapture
  endif
-%}

<variant-live
  class="installments-box spacing-style"
  data-block-id="{{ block.id }}"
  data-product-id="{{ product.id }}"
  style="
    {% render 'spacing-padding', settings: block.settings %}
    --box-border-width: {{ block.settings.border_width }}px;
    --box-radius: {{ block.settings.corner_radius }}px;
    --box-width: {{ block.settings.width }};
    --box-note-reduction: {{ block.settings.note_reduction }}px;
    {% if block.settings.border_color != blank %}--box-border-color: {{ block.settings.border_color }};{% endif %}
    {% if block.settings.background_color != blank %}--box-background: {{ block.settings.background_color }};{% endif %}
    {% if block.settings.text_color != blank %}--color: {{ block.settings.text_color }};{% endif %}
  "
  {{ block.shopify_attributes }}
>
  {%- if show -%}
    <div class="installments-box__inner">
      {%- if block.settings.show_icon -%}
        <span class="installments-box__icon" aria-hidden="true">
          <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
            <rect x="2.5" y="4.5" width="15" height="11" rx="1.5" stroke="currentColor" stroke-width="1.2"/>
            <path d="M2.5 8h15" stroke="currentColor" stroke-width="1.2"/>
          </svg>
        </span>
      {%- endif -%}
      <div class="installments-box__text {{ main_class }}"{% if main_style != blank %} style="{{ main_style }}"{% endif %}>
        <div class="installments-box__lines">
          <span class="installments-box__line">{{ 'blocks.installments_box.label' | t: count: payments, amount: amount }}</span>
          {%- if block.settings.show_note -%}
            <span class="installments-box__note">{{ 'blocks.installments_box.note' | t }}</span>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- elsif request.design_mode -%}
    <p class="installments-box__hint">Installments box hidden: the product needs a price.</p>
  {%- endif -%}
</variant-live>

{% stylesheet %}
  .installments-box {
    display: block;
    box-sizing: border-box;
    width: var(--box-width, 100%);
    max-width: 100%;
    color: var(--color, var(--color-foreground));
    background: var(--box-background, transparent);
    border: var(--box-border-width, 1px) solid var(--box-border-color, currentColor);
    border-radius: var(--box-radius, 0);
  }

  .installments-box:not(:has(.installments-box__inner)) {
    padding: 0;
    border: 0;
  }

  .installments-box__inner {
    display: flex;
    align-items: center;
    gap: var(--gap-md);
  }

  .installments-box__icon {
    display: inline-flex;
    flex: none;
    width: 1.5em;
    height: 1.5em;
  }

  .installments-box__icon svg {
    width: 100%;
    height: 100%;
  }

  .installments-box__lines {
    display: flex;
    flex-direction: column;
    gap: var(--gap-3xs);
  }

  /* The note follows the main line's size, a few pixels smaller, never below 10px. */
  .installments-box__note {
    opacity: 0.7;
    font-weight: 400; /* always Regular, whatever weight the main line has */
    font-size: max(10px, calc(1em - var(--box-note-reduction, 2px)));
  }

  .installments-box__hint {
    margin: 0;
    font-size: 0.75rem;
    opacity: 0.55;
  }
{% endstylesheet %}

