{% assign s = block.settings %}
<gold-purity class="ga-purity spacing-style" style="{% render 'spacing-padding', settings: s %}--ga-tube-height:{{ s.tube_height }}px;--ga-tube-height-mobile:{{ s.tube_height_mobile }}px;--ga-tube-width:{{ s.tube_width }}px;{% if s.text_color != blank %}--ga-purity-text:{{ s.text_color }};{% endif %}{% if s.gold_color != blank %}--ga-gold:{{ s.gold_color }};{% endif %}{% if s.border_color != blank %}--ga-purity-edge:{{ s.border_color }};{% endif %}{% render 'typography-vars', settings: s, prefix: 'title_', name: 'ga-karat-title' %}{% render 'typography-vars', settings: s, prefix: 'body_', name: 'ga-karat-body' %}" {{ block.shopify_attributes }}><div class="ga-purity__grid">{% content_for 'blocks' %}</div></gold-purity>

{% stylesheet %}
gold-purity{display:block;width:100%;min-width:0;color:var(--ga-purity-text,var(--color-foreground))}
.ga-purity__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px 16px;align-items:start;max-width:520px;margin-inline:auto}
.ga-purity:not([data-ready]) .ga-purity__grid{grid-template-columns:1fr}
.ga-karat{min-width:0;display:flex;flex-direction:column;align-items:center}
.ga-karat__button{display:flex;flex-direction:column;align-items:center;gap:18px;width:100%;padding:4px 0 0;border:0;background:transparent;color:inherit;cursor:pointer}
.ga-karat__tube{display:block;position:relative;width:min(100%,var(--ga-tube-width,92px));height:var(--ga-tube-height,220px);border:1px solid var(--ga-purity-edge,var(--color-border));border-radius:999px;overflow:hidden;isolation:isolate}
.ga-karat__fill{position:absolute;inset:auto 0 0;height:var(--ga-purity-percent);background:linear-gradient(180deg,#ebd6ac,var(--ga-gold,#b8955a) 70%,#b3924f);transition:height 1.8s ease;z-index:-1}
.ga-purity[data-ready]:not([data-filled]) .ga-karat__fill{height:0}
.ga-karat__percent{display:block;position:absolute;inset:16px 0 auto;text-align:center;font-family:var(--font-body--family);font-size:12px;color:inherit}
.ga-karat__mark{position:absolute;left:50%;bottom:22%;width:62%;transform:translateX(-50%);text-align:center;color:var(--ga-purity-text,var(--color-foreground));font-family:var(--font-body--family);font-size:8px;letter-spacing:.24em}
.ga-karat__mark img{display:block;width:100%;height:auto;mix-blend-mode:multiply;opacity:.7;margin-bottom:6px}
.ga-karat__label{font-family:var(--ga-karat-title-font-family,var(--font-heading--family));font-size:30px;font-weight:400;line-height:1}
.ga-karat__button[aria-pressed='true'] .ga-karat__tube{border-color:var(--ga-purity-text,var(--color-foreground));box-shadow:0 0 0 4px rgb(80 34 63 / .08)}
.ga-karat__button:focus-visible{outline:2px solid var(--ga-gold,#b8955a);outline-offset:6px}
.ga-karat__detail{width:100%;margin-top:28px;padding-top:24px;border-top:1px solid var(--ga-purity-edge,var(--color-border))}
.ga-karat__detail[hidden]{display:none}
.ga-karat__heading{font-family:var(--ga-karat-title-font-family,var(--font-body--family));font-size:var(--ga-karat-title-font-size,1rem);font-weight:var(--ga-karat-title-font-weight,400);line-height:var(--ga-karat-title-line-height,1.6);letter-spacing:var(--ga-karat-title-letter-spacing,normal);text-transform:var(--ga-karat-title-text-transform,none);margin:0;color:inherit}
.ga-karat__copy{font-family:var(--ga-karat-body-font-family,var(--font-body--family));font-size:var(--ga-karat-body-font-size,1rem);font-weight:var(--ga-karat-body-font-weight,400);line-height:var(--ga-karat-body-line-height,1.6);letter-spacing:var(--ga-karat-body-letter-spacing,normal);text-transform:var(--ga-karat-body-text-transform,none);margin-top:10px;text-wrap:pretty}
.ga-karat__copy p{margin:0}
.ga-karat__note{font-family:var(--font-body--family);font-size:13px;color:var(--ga-gold,#b8955a);margin:14px 0 0}
.ga-purity[data-ready] .ga-karat{display:contents}
.ga-purity[data-ready] .ga-karat__button{grid-row:1}
.ga-purity[data-ready] .ga-karat__detail{grid-row:2;grid-column:1/-1;min-height:180px;margin-top:0}
@media(max-width:749px){.ga-karat__tube{height:var(--ga-tube-height-mobile,180px)}.ga-karat__heading{font-size:var(--ga-karat-title-font-size-mobile,var(--ga-karat-title-font-size,1.5rem))}.ga-karat__copy{font-size:var(--ga-karat-body-font-size-mobile,var(--ga-karat-body-font-size,1rem))}.ga-purity:not([data-ready]) .ga-purity__grid{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){.ga-karat__fill{transition:none}}
{% endstylesheet %}

