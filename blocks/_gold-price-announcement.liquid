{%- doc -%}
  Live gold price for the announcement bar: label, 18k gram price, change since the previous price, update note.
  The change is hidden unless the two latest history entries are at most 5 days apart.
{%- enddoc -%}

{% render 'text-block-styles' %}

{%- liquid
  assign block_settings = block.settings
  assign block_index = section.blocks | find_index: 'id', block.id

  assign gram_price = shop.metafields.gold.price_18k_per_g.value
  assign has_price = false
  if gram_price != blank and gram_price > 0
    assign has_price = true
    assign price_cents = gram_price | times: 100 | round
    assign price_text = price_cents | money
  endif

  comment
    Change since the previous price: only when the two latest history entries are 5 days apart or less
    (a weekend or a holiday). Older entries are monthly backfill points and would give a false change.
  endcomment
  assign show_change = false
  if has_price and block_settings.show_change
    assign history = shop.metafields.gold.price_history.value
    if history.size >= 2
      assign newest_first = history | reverse
      assign latest = newest_first[0]
      assign previous = newest_first[1]
      assign latest_day = latest[0] | date: '%s' | plus: 0
      assign previous_day = previous[0] | date: '%s' | plus: 0
      assign gap_days = latest_day | minus: previous_day | divided_by: 86400.0
      if gap_days >= 0 and gap_days <= 5 and previous[1] > 0
        assign show_change = true
        assign change_percent = latest[1] | minus: previous[1] | times: 100.0 | divided_by: previous[1]
        assign change_abs = change_percent
        if change_percent < 0
          assign change_abs = change_percent | times: -1
        endif

        comment
          One decimal built from whole tenths, so 1.0 never prints as 1 and a zero change is detected
          by a number comparison, not by comparing text.
        endcomment
        assign tenths = change_abs | times: 10 | round
        assign tenth_digit = tenths | modulo: 10
        assign whole_percent = tenths | minus: tenth_digit | divided_by: 10
        assign change_text = whole_percent | append: '.' | append: tenth_digit
        assign direction = 'flat'
        if tenths > 0
          if change_percent > 0
            assign direction = 'up'
          else
            assign direction = 'down'
          endif
        endif
      endif
    endif
  endif
-%}

{%- if has_price -%}
  <slideshow-slide
    ref="slides[]"
    class="
      announcement-bar__slide
      text-block
      text-block--{{ block.id }}
      text-block--align-center
      text-block--full-width
      custom-typography
      {% if block_settings.font_size != "" %}custom-font-size{% endif %}
      {% if block_settings.weight != "" %}custom-font-weight{% endif %}
    "
    style="
      {% render 'typography-style', settings: block_settings, preset: 'custom' %}
      {% if block_settings.text_color != blank %}--color: {{ block_settings.text_color }}; --color-rgb: {{ block_settings.text_color.rgb }};{% endif %}
      --width: 100%;
      --text-align: center;
      --line-height: 1;
      --gold-bar-gap: {{ block_settings.part_gap }}px;
      --gold-bar-note-opacity: {{ block_settings.note_opacity | divided_by: 100.0 }};
    "
    {{ block.shopify_attributes }}
    aria-hidden="{% if block_index == 0 %}false{% else %}true{% endif %}"
  >
    <div class="announcement-bar__text gold-announcement">
      <span class="gold-announcement__label">{{ 'blocks.gold_price_bar.label' | t }}</span>
      <span class="gold-announcement__price">
        <span{% if block_settings.bold_price %} class="gold-announcement__price-value"{% endif %}>
          {{- 'blocks.gold_price_bar.price' | t: price: price_text -}}
        </span>
        {%- if show_change -%}
          <span class="gold-announcement__change gold-announcement__change--{{ direction }}">
            {%- if direction == 'up' -%}
              <svg viewBox="0 0 10 10" aria-hidden="true" focusable="false"><path d="M2 6.5l3-3 3 3" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {%- elsif direction == 'down' -%}
              <svg viewBox="0 0 10 10" aria-hidden="true" focusable="false"><path d="M2 3.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {%- endif -%}
            {{ change_text }}%
          </span>
        {%- endif -%}
      </span>
      {%- if block_settings.show_note -%}
        <span class="gold-announcement__note{% if block_settings.hide_note_on_mobile %} gold-announcement__note--hide-mobile{% endif %}">
          {{- 'blocks.gold_price_bar.note' | t -}}
        </span>
      {%- endif -%}
    </div>
  </slideshow-slide>
{%- elsif request.design_mode -%}
  <slideshow-slide ref="slides[]" class="announcement-bar__slide" {{ block.shopify_attributes }} aria-hidden="false">
    <p class="announcement-bar__text">Gold price hidden: the shop metafield gold.price_18k_per_g is missing</p>
  </slideshow-slide>
{%- endif -%}

{% stylesheet %}
  /* The bar normally caps its width at 680px; the gold line is longer than that. */
  .announcement-bar__slides:has(.gold-announcement) {
    max-width: none;
  }

  .gold-announcement {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    column-gap: var(--gold-bar-gap, 24px);
    row-gap: 4px;
  }

  .gold-announcement__price {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5em;
  }

  .gold-announcement__price-value {
    font-weight: 700;
  }

  .gold-announcement__change {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
  }

  .gold-announcement__change svg {
    width: 0.7em;
    height: 0.7em;
  }

  .gold-announcement__note {
    opacity: var(--gold-bar-note-opacity, 0.8);
  }

  @media screen and (max-width: 749px) {
    .gold-announcement__note--hide-mobile {
      display: none;
    }
  }
{% endstylesheet %}

