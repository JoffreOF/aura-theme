{%- doc -%}
  One ticker item for the Marquee section: "XAU/USD  4,336.70  ▲ 28.90 (+0.67%)  ◆".
  XAU is pure gold per troy ounce. The shop stores the 18k price per gram, so:
    ounce price = 18k gram price x 31.1035 / 0.75
  The change compares the two latest entries of gold.price_history, only when they are 5 days apart or less
  (older entries are monthly back-fill points and would give a false change), the same rule as the announcement bar.
  It is the daily 10:00 AM PET price, not a live feed. Liquid has no operator precedence, so each step is its own assign.
{%- enddoc -%}

{%- liquid
  assign s = block.settings
  assign gram_price = shop.metafields.gold.price_18k_per_g.value | times: 1.0

  assign show = false
  if gram_price > 0
    assign show = true
    assign oz_now = gram_price | times: 31.1035 | divided_by: 0.75
    assign oz_cents = oz_now | times: 100 | round
    assign price_text = oz_cents | money_without_currency
  endif

  assign show_change = false
  if show and s.show_change
    assign history = shop.metafields.gold.price_history.value
    if history.size >= 2
      assign newest_first = history | reverse
      assign latest = newest_first[0]
      assign previous = newest_first[1]
      assign latest_day = latest[0] | date: '%s' | plus: 0
      assign previous_day = previous[0] | date: '%s' | plus: 0
      assign gap_days = latest_day | minus: previous_day | divided_by: 86400.0
      assign previous_gram = previous[1] | times: 1.0
      if gap_days >= 0 and gap_days <= 5 and previous_gram > 0
        assign show_change = true
        assign latest_gram = latest[1] | times: 1.0
        assign oz_latest = latest_gram | times: 31.1035 | divided_by: 0.75
        assign oz_previous = previous_gram | times: 31.1035 | divided_by: 0.75
        assign diff = oz_latest | minus: oz_previous
        assign diff_abs = diff
        if diff < 0
          assign diff_abs = diff | times: -1
        endif
        assign diff_cents = diff_abs | times: 100 | round
        assign diff_text = diff_cents | money_without_currency

        assign pct_abs = diff_abs | times: 100.0 | divided_by: oz_previous
        assign pct_hundredths = pct_abs | times: 100 | round
        assign pct_whole = pct_hundredths | divided_by: 100 | floor
        assign pct_frac = pct_hundredths | modulo: 100
        assign pct_frac_text = pct_frac | append: ''
        if pct_frac < 10
          assign pct_frac_text = '0' | append: pct_frac_text
        endif
        assign pct_text = pct_whole | append: '.' | append: pct_frac_text

        assign direction = 'flat'
        assign sign = ''
        if pct_hundredths > 0
          if diff > 0
            assign direction = 'up'
            assign sign = '+'
          else
            assign direction = 'down'
            assign sign = '-'
          endif
        endif
      endif
    endif
  endif

  assign item_class = s.item_preset
  assign item_style = ''
  if s.item_preset == 'custom'
    assign item_class = 'custom-typography'
    if s.item_font_size != blank
      assign item_class = item_class | append: ' custom-font-size'
    endif
    capture item_style
      render 'custom-typography-style', settings: s, prefix: 'item_'
    endcapture
  endif
-%}

{%- if show -%}
  <div
    class="gold-ticker {{ item_class }}"
    style="
      {{ item_style }}
      --ticker-gap: {{ s.part_gap }}px;
      --ticker-label-weight: {{ s.label_weight }};
      --ticker-change-scale: {{ s.change_scale | divided_by: 100.0 }};
      {% if s.text_color != blank %}--ticker-color: {{ s.text_color }};{% endif %}
      {% if s.change_color != blank %}--ticker-change-color: {{ s.change_color }};{% endif %}
      {% if s.diamond_color != blank %}--ticker-diamond: {{ s.diamond_color }};{% endif %}
      --ticker-diamond-size: {{ s.diamond_size }}px;
      --ticker-diamond-space: {{ s.diamond_space }}px;
    "
    {{ block.shopify_attributes }}
  >
    <span class="gold-ticker__label">{{ s.label }}</span>
    <span class="gold-ticker__price">{{ price_text }}</span>
    {%- if show_change -%}
      <span class="gold-ticker__change gold-ticker__change--{{ direction }}">
        {%- if direction == 'up' -%}
          <svg viewBox="0 0 10 10" aria-hidden="true" focusable="false"><path d="M5 2l4 6.5H1z" fill="currentColor"/></svg>
        {%- elsif direction == 'down' -%}
          <svg viewBox="0 0 10 10" aria-hidden="true" focusable="false"><path d="M5 8L1 1.5h8z" fill="currentColor"/></svg>
        {%- endif -%}
        {{ diff_text }} ({{ sign }}{{ pct_text }}%)
      </span>
    {%- endif -%}
    {%- if s.show_diamond -%}
      <span class="gold-ticker__diamond" aria-hidden="true"></span>
    {%- endif -%}
  </div>
{%- elsif request.design_mode -%}
  <p class="gold-ticker__hint">Gold price hidden: the shop metafield gold.price_18k_per_g is missing.</p>
{%- endif -%}

{% stylesheet %}
  .gold-ticker {
    display: inline-flex;
    flex: none;
    align-items: baseline;
    gap: var(--ticker-gap, 16px);
    white-space: nowrap;
    color: var(--ticker-color, currentColor);
  }

  .gold-ticker__label {
    font-weight: var(--ticker-label-weight, 600);
    letter-spacing: 0.04em;
  }

  .gold-ticker__change {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    white-space: nowrap;
    font-size: calc(1em * var(--ticker-change-scale, 0.9));
    color: var(--ticker-change-color, currentColor);
  }

  .gold-ticker__change svg {
    width: 0.8em;
    height: 0.8em;
  }

  /* A small gold diamond after each item, so the repeats in the strip are separated */
  .gold-ticker__diamond {
    align-self: center;
    flex: none;
    width: var(--ticker-diamond-size, 8px);
    height: var(--ticker-diamond-size, 8px);
    margin-inline: var(--ticker-diamond-space, 24px);
    background: var(--ticker-diamond, #c4a35a);
    transform: rotate(45deg);
  }

  .gold-ticker__hint {
    margin: 0;
    font-size: 0.75rem;
    opacity: 0.55;
  }
{% endstylesheet %}

