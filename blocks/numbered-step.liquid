{%- doc -%}
  One numbered step ("01  Choose your pieces / text"). Several in a row count by themselves through a CSS counter,
  or the number can be typed. Number, title and text each have their own typography.
{%- enddoc -%}

{%- liquid
  assign s = block.settings

  assign number_class = s.number_preset
  assign number_style = ''
  if s.number_preset == 'custom'
    assign number_class = 'custom-typography'
    if s.number_font_size != blank
      assign number_class = number_class | append: ' custom-font-size'
    endif
    capture number_style
      render 'custom-typography-style', settings: s, prefix: 'number_'
    endcapture
  endif

  assign title_class = s.title_preset
  assign title_style = ''
  if s.title_preset == 'custom'
    assign title_class = 'custom-typography'
    if s.title_font_size != blank
      assign title_class = title_class | append: ' custom-font-size'
    endif
    capture title_style
      render 'custom-typography-style', settings: s, prefix: 'title_'
    endcapture
  endif

  assign body_class = s.body_preset
  assign body_style = ''
  if s.body_preset == 'custom'
    assign body_class = 'custom-typography'
    if s.body_font_size != blank
      assign body_class = body_class | append: ' custom-font-size'
    endif
    capture body_style
      render 'custom-typography-style', settings: s, prefix: 'body_'
    endcapture
  endif
-%}

<div
  class="numbered-step spacing-style{% if s.show_line %} numbered-step--line{% endif %}"
  style="
    {% render 'spacing-padding', settings: s %}
    --step-number-column: {{ s.number_column }}px;
    --step-gap: {{ s.gap }}px;
    --step-body-opacity: {{ s.body_opacity | divided_by: 100.0 }};
    {% if s.line_color != blank %}--step-line-color: {{ s.line_color }};{% endif %}
    {% if s.number_color != blank %}--step-number-color: {{ s.number_color }};{% endif %}
    {% if s.title_color != blank %}--step-title-color: {{ s.title_color }};{% endif %}
    {% if s.body_color != blank %}--step-body-color: {{ s.body_color }};{% endif %}
  "
  {{ block.shopify_attributes }}
>
  <div
    class="numbered-step__number {{ number_class }}{% if s.number == blank %} numbered-step__number--auto{% endif %}"
    {% if number_style != blank %}style="{{ number_style }}"{% endif %}
    aria-hidden="true"
  >
    {{- s.number -}}
  </div>
  <div class="numbered-step__content">
    {%- if s.title != blank -%}
      <p class="numbered-step__title {{ title_class }}"{% if title_style != blank %} style="{{ title_style }}"{% endif %}>{{ s.title }}</p>
    {%- endif -%}
    {%- if s.text != blank -%}
      <p class="numbered-step__text {{ body_class }}"{% if body_style != blank %} style="{{ body_style }}"{% endif %}>{{ s.text }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .numbered-step {
    display: grid;
    grid-template-columns: var(--step-number-column, 60px) minmax(0, 1fr);
    align-items: start;
    width: 100%;
    box-sizing: border-box;
    /* Steps that sit next to each other share one counter (01, 02, 03). */
    counter-increment: aura-step;
  }

  .numbered-step--line {
    border-block-start: 1px solid var(--step-line-color, var(--color-border));
  }

  .numbered-step__number {
    color: var(--step-number-color, var(--color-foreground));
    line-height: 1.2;
  }

  .numbered-step__number--auto::before {
    content: counter(aura-step, decimal-leading-zero);
  }

  .numbered-step__content {
    display: flex;
    flex-direction: column;
    gap: var(--step-gap, 6px);
    min-width: 0;
  }

  .numbered-step__title,
  .numbered-step__text {
    margin: 0;
  }

  .numbered-step__title {
    color: var(--step-title-color, var(--color-foreground));
  }

  .numbered-step__text {
    color: var(--step-body-color, var(--color-foreground));
    opacity: var(--step-body-opacity, 0.75);
  }
{% endstylesheet %}

